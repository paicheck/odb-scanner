<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Classic Bluetooth SPP. BLUETOOTH/BLUETOOTH_ADMIN cover Android <= 11;
         BLUETOOTH_CONNECT covers 12+; BLUETOOTH_SCAN finds the adapter. -->
    <uses-permission
        android:name="android.permission.BLUETOOTH"
        android:maxSdkVersion="30" />
    <uses-permission
        android:name="android.permission.BLUETOOTH_ADMIN"
        android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <uses-permission
        android:name="android.permission.BLUETOOTH_SCAN"
        android:usesPermissionFlags="neverForLocation" />

    <!-- Classic Bluetooth *discovery* (finding an unpaired ELM327 dongle)
         requires location on Android 6-11; from Android 12 BLUETOOTH_SCAN
         replaces it (and neverForLocation above removes the location need). -->
    <uses-permission
        android:name="android.permission.ACCESS_FINE_LOCATION"
        android:maxSdkVersion="30" />

    <!-- Cloud ingest. Without this the uploader fails with a SecurityException
         before the request leaves the phone, because targetSdk >= 28 does not
         grant it implicitly. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:label="ODB Scanner"
        android:allowBackup="false"
        android:theme="@style/Theme.ODBScanner">
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
