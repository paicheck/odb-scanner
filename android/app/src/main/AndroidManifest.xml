<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Classic Bluetooth SPP. BLUETOOTH/BLUETOOTH_ADMIN cover Android <= 11;
         BLUETOOTH_CONNECT covers 12+; BLUETOOTH_SCAN finds the adapter. -->
    <uses-permission
        android:name="android.permission.BLUETOOTH"
        android:maxSdkVersion="30" />
    <uses-permission
        android:name="android.permission.BLUETOOTH_ADMIN"
        android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <uses-permission
        android:name="android.permission.BLUETOOTH_SCAN"
        android:usesPermissionFlags="neverForLocation" />

    <!-- Precise location. Classic Bluetooth *discovery* needs it on Android
         6-11 (from 12, BLUETOOTH_SCAN + neverForLocation replace it). On every
         version, the route planner asks for it only when a trip is started:
         re-planning while driving must know where on the road the car is, and
         approximate location is ~2 km off and refreshed at most every 10 min. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />

    <!-- Cloud ingest. Without this the uploader fails with a SecurityException
         before the request leaves the phone, because targetSdk >= 28 does not
         grant it implicitly. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Route planner: trips start from the phone's position. Coarse is
         enough to plan energy (navigation itself is the maps app's job), and
         it is asked only when the driver plans a trip without a typed start. -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <!-- Car-phone mode: keep the Bluetooth socket alive with the screen off
         (foreground service), auto-start on boot, and keep the CPU awake. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE" />
    <!-- Trip watch: while a trip is driven (Google Maps in front), the
         location-type foreground service is what lets the phone still read its
         position to re-plan. Runs only between Start navigation and arrival. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
    <!-- Wake word: while the driver has it on, a microphone-type foreground
         service listens for the phrase, on the phone (Vosk, offline), with a
         notification that says so and a Stop button. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!-- Assistant voice: the microphone for spoken questions (asked when the
         driver first taps Speak), and the phone's speech recogniser and
         text-to-speech engine, which Android 11+ hides unless declared. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- "Display over other apps": asked for only when trips go to Google Maps,
         and used for one thing: Android lets an app in the background open
         Google Maps (a re-planned trip, on the driver's spoken yes) only with
         it. The app draws nothing over other apps (route/MapsHandoff.kt). -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <queries>
        <package android:name="com.google.android.apps.maps" />
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE" />
        </intent>
    </queries>

    <application
        android:label="ODB Scanner"
        android:allowBackup="false"
        android:theme="@style/Theme.ODBScanner">
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".service.CollectorService"
            android:exported="false"
            android:foregroundServiceType="connectedDevice" />

        <service
            android:name=".route.TripService"
            android:exported="false"
            android:foregroundServiceType="location|microphone" />

        <service
            android:name=".ai.WakeWordService"
            android:exported="false"
            android:foregroundServiceType="microphone|location" />

        <!-- Android Auto: Battery, Route planner and Fault codes on the car
             screen. Read-only like the rest of the app: the car screens show
             what the phone database holds and never reach the adapter. -->
        <service
            android:name=".car.OdbCarAppService"
            android:exported="true">
            <intent-filter>
                <action android:name="androidx.car.app.CarAppService" />
                <category android:name="androidx.car.app.category.CHARGING" />
            </intent-filter>
        </service>
        <meta-data
            android:name="com.google.android.gms.car.application"
            android:resource="@xml/automotive_app_desc" />
        <meta-data
            android:name="androidx.car.app.minCarApiLevel"
            android:value="2" />

        <!-- A suggested plan's Switch / Keep buttons, and a notification's
             tap that hands the current plan to Google Maps (route/TripActions.kt). -->
        <receiver
            android:name=".route.TripActionReceiver"
            android:exported="false" />
        <activity
            android:name=".route.HandoffActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:taskAffinity=""
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />

        <receiver
            android:name=".service.BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
