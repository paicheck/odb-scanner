<?xml version="1.0" encoding="utf-8"?>
<!-- Debug builds only: plain HTTP to the emulator's alias for the host PC
     (10.0.2.2), so the assistant can be tested against a local stand-in AI
     service. Everything else stays HTTPS-only, as in a release build. -->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">10.0.2.2</domain>
    </domain-config>
</network-security-config>
