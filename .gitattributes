# The Windows shortcuts are .bat files and must keep CRLF endings: cmd.exe
# misparses labels and goto in a .bat saved with bare LF, and the symptom is
# a shortcut that silently does nothing. Without this, git's default text
# handling would rewrite them to LF on checkout on some platforms.
*.bat text eol=crlf
# Vendored third-party files are kept byte-for-byte as downloaded, so their
# SHA-256 in web/static/vendor/README.md stays checkable on any checkout.
web/static/vendor/** -text
# Archived evidence is kept byte-for-byte as captured, so the SHA-256 and
# byte count in each *.manifest.json (and in the docs that quote them) match
# on any checkout. The archives were written on Windows with CRLF endings;
# git used to store them as LF, so the hashes only held on a Windows checkout.
research/measurement_discovery/captures/*.json -text
