__pycache__/
*.pyc
data/*.db
data/*.db-journal
data/*.db-wal
data/*.db-shm
data/logs/
# `main.py backup` snapshots. These are copies of the vehicle's own history and
# can be large; a database committed to git is also a data-retention problem.
data/backups/
**/backups/
.venv/
venv/
.pytest_cache/
.ruff_cache/
config.local.yaml
# Local overrides for `docker compose -f cloud/docker-compose.yml` (database and
# API passwords). Defaults in the compose file are development values; a real
# password must not be committed.
cloud/.env
cloud/cpanel.env

# Generated experiment records. These are run output, not source: one holds a
# simulator self-test, the other whatever the last real run produced. Both are
# evidence about a specific run, and neither belongs in history -- committing
# them would let a stale file be mistaken for the current state of the BMS.
docs/experiment_record_results.md
docs/experiment_record_sim.md

# Generated investigation output and scratch (regenerable, not source)
*.out
*.out.txt
tools/exports/
tools/phase_c_arithmetic.json
tools/_phase_c_arithmetic.json
_phase_c_arithmetic.json

