# cPanel deploy secrets. Copy this to cloud/cpanel.env and fill in.
# cloud/cpanel.env is gitignored -- never commit it.
#
# These are the exact variables cloud/config.py already reads, so the API needs
# no other configuration.

# The bearer token clients (collector + Android app) must present. Generate one:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
ODB_CLOUD_API_TOKEN=

# The MySQL database and user you created in cPanel -> MySQL Databases.
# On shared hosting the host is localhost (or 127.0.0.1).
ODB_CLOUD_DB_HOST=localhost
ODB_CLOUD_DB_PORT=3306
ODB_CLOUD_DB_USER=
ODB_CLOUD_DB_PASSWORD=
ODB_CLOUD_DB_NAME=
