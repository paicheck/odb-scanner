# Production cloud deploy secrets. Copy this to cloud/.env and fill in real
# values. cloud/.env is gitignored (see .gitignore) -- never commit it.
#
#   cp cloud/.env.example cloud/.env
#
# docker compose -f cloud/docker-compose.prod.yml reads cloud/.env automatically
# because it sits beside the compose file.

# A long random password for MariaDB's root account. Used only inside the stack
# (the database is not reachable from outside). Generate one:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
DB_ROOT_PASSWORD=

# The application database and the user the API connects as. These are created
# by the MariaDB container on first start.
DB_NAME=odb_cloud
DB_USER=odb_ingest
DB_PASSWORD=

# The bearer token clients (collector + Android app) must present. This is the
# credential that travels to the API, so it is the one you rotate if a phone is
# lost. Generate one:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
API_TOKEN=

# The hostname that points at this VPS (an A/AAAA record), used for automatic
# HTTPS. Example: cloud.example.com
DOMAIN=
